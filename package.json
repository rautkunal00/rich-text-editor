{
  "name": "rich-text-enhanced-editor",
  "version": "0.0.6",
  "description": "A powerful, extensible iframe-based custom rich text editor built on Tiptap v3.",
  "main": "dist/rich-text-enhanced-editor.umd.min.js",
  "module": "dist/rich-text-enhanced-editor.es.min.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/rich-text-enhanced-editor.es.min.js",
      "require": "./dist/rich-text-enhanced-editor.umd.min.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "vite",
    "dev": "npm run build:sass && vite",
    "build:sass": "sass src/assets/styles/style.scss src/assets/styles/style.css --no-source-map",
    "build": "npm run build:sass && tsc",
    "prod-build": "npm run build:sass && vite build",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "editor",
    "tiptap",
    "typescript"
  ],
  "author": "Kunal Raut",
  "license": "MIT",
  "dependencies": {
    "@floating-ui/dom": "^1.7.2",
    "@jaames/iro": "^5.5.2",
    "@tiptap/core": "^3.0.1",
    "@tiptap/extension-highlight": "^3.0.7",
    "@tiptap/extension-subscript": "^3.0.7",
    "@tiptap/extension-superscript": "^3.0.7",
    "@tiptap/extension-table": "^3.0.7",
    "@tiptap/extension-table-cell": "^3.0.7",
    "@tiptap/extension-table-header": "^3.0.7",
    "@tiptap/extension-table-row": "^3.0.7",
    "@tiptap/extension-text-align": "^3.0.7",
    "@tiptap/extension-text-style": "^3.0.7",
    "@tiptap/extensions": "^3.0.7",
    "@tiptap/starter-kit": "^3.0.1",
    "dompurify": "^3.2.6"
  },
  "devDependencies": {
    "@types/node": "^24.0.4",
    "sass": "^1.89.2",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
